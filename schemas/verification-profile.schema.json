{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:geldmacher:workflow-verification-profile:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "version", "skill_path", "feature_map_path", "capabilities", "artifact_policy"],
  "properties": {
    "schema": { "const": 1 },
    "profile_id": { "type": "string", "pattern": "^verify-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "skill_path": { "type": "string", "minLength": 1 },
    "feature_map_path": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["launch", "doctor", "drive", "observe", "evidence", "reset", "cleanup"] }
    },
    "host_commands": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "launch": { "$ref": "#/$defs/argv" },
        "doctor": { "$ref": "#/$defs/argv" },
        "reset": { "$ref": "#/$defs/argv" },
        "cleanup": { "$ref": "#/$defs/argv" }
      }
    },
    "artifact_policy": { "const": "external-only" }
  },
  "$defs": {
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
