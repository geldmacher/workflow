{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:geldmacher:workflow-artifact:delivery-evidence:6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact", "schema", "id", "status", "root_plan_id", "subject_id", "representation",
    "source_review_id", "predecessor_evidence_id", "intent_hash", "evidence_mode", "overall_grade",
    "affected_objectives", "reused_objectives", "executed_checks", "reused_checks", "check_evidence",
    "changed_paths", "workspace_snapshot_hash"
  ],
  "properties": {
    "artifact": { "const": "delivery-evidence" },
    "schema": { "const": 6 },
    "id": { "type": "string", "pattern": "^de-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "status": { "enum": ["complete", "provisional", "blocked"] },
    "created_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "root_plan_id": { "type": "string", "pattern": "^wp-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "subject_id": { "type": "string", "pattern": "^(?:wp|cp)-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "source_review_id": { "type": ["string", "null"], "pattern": "^wr-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "predecessor_evidence_id": { "type": ["string", "null"], "pattern": "^de-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "representation": { "enum": ["full", "delta"] },
    "intent_hash": { "$ref": "#/$defs/hash" },
    "evidence_mode": { "enum": ["lean", "full"] },
    "overall_grade": { "enum": ["verified", "supported", "partial", "unavailable", "failed"] },
    "workspace_snapshot_hash": { "$ref": "#/$defs/hash" },
    "changed_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "check_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "grade", "observed", "evidence_hashes", "limitations"],
        "properties": {
          "check_id": { "type": "string", "pattern": "^CHECK-[1-9][0-9]*$" },
          "grade": { "enum": ["verified", "supported", "partial", "unavailable", "failed"] },
          "observed": { "type": "string", "minLength": 1 },
          "evidence_hashes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
          "attestation_hash": { "$ref": "#/$defs/hash" },
          "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "allOf": [
          {
            "if": { "properties": { "grade": { "const": "verified" } }, "required": ["grade"] },
            "then": { "required": ["attestation_hash"], "properties": { "evidence_hashes": { "minItems": 1 } } }
          },
          {
            "if": { "properties": { "grade": { "const": "unavailable" } }, "required": ["grade"] },
            "then": { "properties": { "limitations": { "minItems": 1 } } }
          }
        ]
      }
    },
    "affected_objectives": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^OBJ-[1-9][0-9]*$" } },
    "reused_objectives": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^OBJ-[1-9][0-9]*$" } },
    "executed_checks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CHECK-[1-9][0-9]*$" } },
    "reused_checks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CHECK-[1-9][0-9]*$" } },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "allOf": [{
    "if": { "properties": { "subject_id": { "pattern": "^wp-" } } },
    "then": {
      "properties": {
        "source_review_id": { "type": ["null"] },
        "predecessor_evidence_id": { "type": ["null"] },
        "representation": { "const": "full" },
        "reused_objectives": { "maxItems": 0 },
        "reused_checks": { "maxItems": 0 }
      }
    },
    "else": {
      "required": ["source_review_id", "predecessor_evidence_id"],
      "properties": { "source_review_id": { "type": "string" }, "predecessor_evidence_id": { "type": "string" } }
    }
  }],
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
  "x-required-sections": ["Summary"]
}
