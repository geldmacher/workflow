{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:geldmacher:workflow-artifact:work-review:6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact", "schema", "id", "root_plan_id", "latest_evidence_id", "outcome", "next_action",
    "status", "correction_id", "predecessor_review_id", "inspected_objectives", "reused_objectives",
    "inspected_checks", "reused_checks", "findings", "open_points"
  ],
  "properties": {
    "artifact": { "const": "work-review" },
    "schema": { "const": 6 },
    "id": { "type": "string", "pattern": "^wr-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "status": { "const": "complete" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "root_plan_id": { "type": "string", "pattern": "^wp-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "latest_evidence_id": { "type": ["string", "null"], "pattern": "^de-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "review_basis": { "enum": ["evidence", "root-boundary"] },
    "boundary_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "observed_at", "recovery_error_code", "reason_codes", "root_content_hash", "repository_snapshot_hash", "observed_paths"],
      "properties": {
        "receipt_id": { "type": "string", "pattern": "^br-[a-f0-9]{64}$" },
        "observed_at": { "type": "string", "format": "date-time" },
        "recovery_error_code": { "enum": ["baseline-unavailable-after-mutation", "authority-violation", "repository-observation-conflict", "artifact-text-conflict"] },
        "reason_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["baseline-unavailable-after-mutation", "out-of-authority-changes", "workspace-ambiguous-after-mutation", "root-binding-lost-after-mutation"] } },
        "root_content_hash": { "$ref": "#/$defs/hash" },
        "repository_snapshot_hash": { "$ref": "#/$defs/hash" },
        "observed_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "outcome": { "enum": ["achieved", "correction-needed", "open-points"] },
    "next_action": { "enum": ["none", "correct", "human-assessment"] },
    "correction_id": { "type": ["string", "null"], "pattern": "^cp-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "predecessor_review_id": { "type": ["string", "null"], "pattern": "^wr-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "inspected_objectives": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^OBJ-[1-9][0-9]*$" } },
    "reused_objectives": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^OBJ-[1-9][0-9]*$" } },
    "inspected_checks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CHECK-[1-9][0-9]*$" } },
    "reused_checks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CHECK-[1-9][0-9]*$" } },
    "findings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/finding" } },
    "open_points": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/openPoint" } },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": { "properties": { "review_basis": { "const": "root-boundary" } }, "required": ["review_basis"] },
      "then": { "required": ["boundary_receipt"], "properties": { "latest_evidence_id": { "type": "null" }, "outcome": { "const": "open-points" }, "next_action": { "const": "human-assessment" }, "correction_id": { "type": "null" }, "open_points": { "minItems": 1 } } },
      "else": { "properties": { "latest_evidence_id": { "type": "string", "pattern": "^de-[A-Za-z0-9][A-Za-z0-9-]*$" } }, "not": { "required": ["boundary_receipt"] } }
    },
    { "if": { "properties": { "outcome": { "const": "achieved" } }, "required": ["outcome"] }, "then": { "properties": { "next_action": { "const": "none" }, "correction_id": { "type": "null" }, "findings": { "maxItems": 0 }, "open_points": { "maxItems": 0 } } } },
    { "if": { "properties": { "outcome": { "const": "correction-needed" } }, "required": ["outcome"] }, "then": { "properties": { "next_action": { "const": "correct" }, "correction_id": { "type": "string" }, "findings": { "minItems": 1 } } } },
    { "if": { "properties": { "outcome": { "const": "open-points" } }, "required": ["outcome"] }, "then": { "properties": { "next_action": { "const": "human-assessment" }, "correction_id": { "type": "null" }, "open_points": { "minItems": 1 } } } }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "severity", "objective_ids", "check_ids", "evidence", "reasoning", "resolution"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "objective_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^OBJ-[1-9][0-9]*$" } },
        "check_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^CHECK-[1-9][0-9]*$" } },
        "evidence": { "type": "string", "minLength": 1 },
        "reasoning": { "type": "string", "minLength": 1 },
        "resolution": { "enum": ["correct", "open"] }
      }
    },
    "openPoint": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "type", "summary", "evidence", "impact", "question"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "type": { "enum": ["evidence", "authority", "intent", "environment", "formal-binding", "no-progress"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 }
      }
    }
  },
  "x-required-sections": ["Outcome", "Next action"]
}
