{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:geldmacher:workflow-artifact:work-review:6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact", "schema", "id", "root_plan_id", "latest_evidence_id", "assessment", "delivery_status", "next_action",
    "status", "correction_id", "predecessor_review_id",
    "inspected_objectives", "reused_objectives", "inspected_checks", "reused_checks"
  ],
  "properties": {
    "artifact": { "const": "work-review" },
    "schema": { "const": 6 },
    "id": { "type": "string", "pattern": "^wr-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "status": { "const": "complete" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "root_plan_id": { "type": "string", "pattern": "^wp-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "latest_evidence_id": { "type": ["string", "null"], "pattern": "^de-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "review_basis": { "enum": ["evidence", "root-boundary"] },
    "boundary_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "observed_at", "recovery_error_code", "reason_codes", "root_content_hash", "repository_snapshot_hash", "observed_paths"],
      "properties": {
        "receipt_id": { "type": "string", "pattern": "^br-[a-f0-9]{64}$" },
        "observed_at": { "type": "string", "format": "date-time" },
        "recovery_error_code": { "enum": ["baseline-unavailable-after-mutation", "authority-violation", "repository-observation-conflict", "artifact-text-conflict"] },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["baseline-unavailable-after-mutation", "out-of-authority-changes", "workspace-ambiguous-after-mutation", "root-binding-lost-after-mutation"] }
        },
        "root_content_hash": { "$ref": "#/$defs/hash" },
        "repository_snapshot_hash": { "$ref": "#/$defs/hash" },
        "observed_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "assessment": { "enum": ["achieved", "provisional", "mostly-achieved", "partially-achieved", "not-achieved", "insufficient-evidence"] },
    "delivery_status": { "enum": ["verified", "provisional", "blocked"] },
    "next_action": { "enum": ["none", "accept-provisional", "correct", "clarify", "replan", "retry-review"] },
    "correction_id": { "type": ["string", "null"], "pattern": "^cp-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "predecessor_review_id": { "type": ["string", "null"], "pattern": "^wr-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "inspected_objectives": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^OBJ-[1-9][0-9]*$" } },
    "reused_objectives": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^OBJ-[1-9][0-9]*$" } },
    "inspected_checks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CHECK-[1-9][0-9]*$" } },
    "reused_checks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CHECK-[1-9][0-9]*$" } },
    "learning_candidates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^LRN-[A-Za-z0-9][A-Za-z0-9-]*$" } },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": { "properties": { "review_basis": { "const": "root-boundary" } }, "required": ["review_basis"] },
      "then": {
        "required": ["boundary_receipt"],
        "properties": {
          "latest_evidence_id": { "type": "null" },
          "assessment": { "const": "insufficient-evidence" },
          "delivery_status": { "const": "blocked" },
          "next_action": { "const": "replan" },
          "correction_id": { "type": "null" },
          "inspected_objectives": { "maxItems": 0 },
          "reused_objectives": { "maxItems": 0 },
          "inspected_checks": { "maxItems": 0 },
          "reused_checks": { "maxItems": 0 }
        },
        "not": { "required": ["learning_candidates"] }
      },
      "else": {
        "properties": { "latest_evidence_id": { "type": "string", "pattern": "^de-[A-Za-z0-9][A-Za-z0-9-]*$" } },
        "not": { "required": ["boundary_receipt"] }
      }
    },
    { "if": { "properties": { "assessment": { "const": "achieved" } }, "required": ["assessment"] }, "then": { "properties": { "delivery_status": { "const": "verified" }, "next_action": { "const": "none" } } } },
    { "if": { "properties": { "delivery_status": { "const": "provisional" } }, "required": ["delivery_status"] }, "then": { "properties": { "next_action": { "const": "accept-provisional" } } } },
    {
      "if": { "properties": { "next_action": { "const": "correct" } }, "required": ["next_action"] },
      "then": { "required": ["learning_candidates"], "properties": { "correction_id": { "type": "string" } } },
      "else": { "properties": { "correction_id": { "type": "null" } }, "not": { "required": ["learning_candidates"] } }
    }
  ],
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
  "x-required-sections": ["Assessment", "Next action"]
}
