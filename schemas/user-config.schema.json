{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:geldmacher:workflow-user-config:2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "route_profiles", "planning_preflight_budget"],
  "properties": {
    "schema": { "const": 2 },
    "route_profiles": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["planner", "investigator", "writer", "writer_escalated", "verifier", "reviewer", "explainer"],
        "properties": {
          "planner": { "$ref": "#/$defs/pool" }, "investigator": { "$ref": "#/$defs/pool" },
          "writer": { "$ref": "#/$defs/pool" }, "writer_escalated": { "$ref": "#/$defs/pool" },
          "verifier": { "$ref": "#/$defs/pool" }, "reviewer": { "$ref": "#/$defs/pool" }, "explainer": { "$ref": "#/$defs/pool" }
        }
      }
    },
    "planning_preflight_budget": { "$ref": "#/$defs/planningBudget" },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "pricing": {
      "type": "object", "additionalProperties": false, "required": ["input", "output", "cache_read", "cache_write"],
      "properties": { "input": { "type": "number", "minimum": 0 }, "output": { "type": "number", "minimum": 0 }, "cache_read": { "type": "number", "minimum": 0 }, "cache_write": { "type": "number", "minimum": 0 } }
    },
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["model_id", "reasoning_effort", "pricing_usd_per_million"],
      "properties": { "model_id": { "type": "string", "minLength": 1 }, "reasoning_effort": { "type": "string", "minLength": 1 }, "model_options": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }, "pricing_usd_per_million": { "$ref": "#/$defs/pricing" } }
    },
    "pool": {
      "type": "object", "additionalProperties": false, "required": ["selection", "fallback", "candidates"],
      "properties": { "selection": { "const": "ordered" }, "fallback": { "const": "approved-pool" }, "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/candidate" } } }
    },
    "planningBudget": {
      "type": "object", "additionalProperties": false, "required": ["max_active_minutes", "max_total_tokens", "max_cost_usd", "max_validation_repairs"],
      "properties": { "max_active_minutes": { "type": "integer", "minimum": 1 }, "max_total_tokens": { "type": "integer", "minimum": 1 }, "max_cost_usd": { "type": "number", "exclusiveMinimum": 0 }, "max_validation_repairs": { "type": "integer", "minimum": 0 } }
    }
  }
}
