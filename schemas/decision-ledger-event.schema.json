{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:geldmacher:workflow-decision-ledger-event:1",
  "type": "object", "additionalProperties": false,
  "required": ["id", "at", "type", "payload", "previous_hash", "event_hash"],
  "properties": {
    "id": { "type": "string" }, "at": { "type": "string", "format": "date-time" }, "type": { "type": "string" },
    "payload": { "type": "object" }, "previous_hash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "event_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
