{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:geldmacher:workflow:manual-workflow-request:1",
  "title": "Workflow 6 stateless Manual builder request",
  "oneOf": [
    { "$ref": "#/$defs/buildPlan" },
    { "$ref": "#/$defs/validatePlan" },
    { "$ref": "#/$defs/buildReview" },
    { "$ref": "#/$defs/status" }
  ],
  "$defs": {
    "line": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "reviewLine": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "findingLine": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "targetLine": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "artifactText": { "type": "string", "minLength": 1, "maxLength": 1000000 },
    "presentationLocale": { "enum": ["de", "en"], "default": "en" },
    "artifactEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "text"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "text": { "$ref": "#/$defs/artifactText" }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/artifactEntry" }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "severity", "objective_ids", "check_ids", "evidence", "reasoning", "resolution"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "objective_ids": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "pattern": "^OBJ-[1-9][0-9]*$" } },
        "check_ids": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "pattern": "^CHECK-[1-9][0-9]*$" } },
        "evidence": { "$ref": "#/$defs/findingLine" },
        "reasoning": { "$ref": "#/$defs/findingLine" },
        "resolution": { "enum": ["correct", "open"] }
      }
    },
    "openPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "summary", "evidence", "impact", "question"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
        "type": { "enum": ["evidence", "authority", "intent", "environment", "formal-binding", "no-progress"] },
        "summary": { "$ref": "#/$defs/reviewLine" },
        "evidence": { "$ref": "#/$defs/findingLine" },
        "impact": { "$ref": "#/$defs/reviewLine" },
        "question": { "$ref": "#/$defs/reviewLine" }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixes", "steps"],
      "properties": {
        "fixes": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/correctionFix" } },
        "steps": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/correctionStep" } }
      }
    },
    "semanticKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "semanticKeys": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/semanticKey" } },
    "correctionFix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "finding_keys", "required_outcome", "evidence"],
      "properties": {
        "key": { "$ref": "#/$defs/semanticKey" },
        "finding_keys": { "$ref": "#/$defs/semanticKeys" },
        "required_outcome": { "$ref": "#/$defs/reviewLine" },
        "evidence": { "$ref": "#/$defs/reviewLine" }
      }
    },
    "correctionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "fix_keys", "targets", "required_outcome", "implementation_latitude", "completion_probe", "root_check_ids", "deviation_action"],
      "properties": {
        "key": { "$ref": "#/$defs/semanticKey" },
        "fix_keys": { "$ref": "#/$defs/semanticKeys" },
        "targets": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/targetLine" } },
        "required_outcome": { "$ref": "#/$defs/reviewLine" },
        "implementation_latitude": { "$ref": "#/$defs/reviewLine" },
        "completion_probe": { "$ref": "#/$defs/reviewLine" },
        "root_check_ids": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^CHECK-[1-9][0-9]*$" } },
        "deviation_action": { "$ref": "#/$defs/reviewLine" }
      }
    },
    "reviewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "outcome", "assessment_summary", "snapshot_summary", "findings", "open_points"],
      "properties": {
        "schema": { "const": 1 },
        "kind": { "const": "review-input" },
        "outcome": { "enum": ["achieved", "correction-needed", "open-points"] },
        "assessment_summary": { "$ref": "#/$defs/reviewLine" },
        "snapshot_summary": { "$ref": "#/$defs/reviewLine" },
        "findings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/finding" } },
        "open_points": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/openPoint" } },
        "correction": { "$ref": "#/$defs/correction" }
      }
    },
    "repositoryObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "repository_root", "subject_changed_paths", "ambient_changed_paths", "snapshot_material", "limitations"],
      "properties": {
        "schema": { "const": 1 },
        "kind": { "const": "unprotected-repository-observation" },
        "repository_root": { "$ref": "#/$defs/line" },
        "subject_changed_paths": { "type": "array", "maxItems": 20000, "items": { "$ref": "#/$defs/line" } },
        "ambient_changed_paths": { "type": "array", "maxItems": 20000, "items": { "$ref": "#/$defs/line" } },
        "snapshot_material": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "type": "string", "minLength": 1, "maxLength": 100000 } },
        "limitations": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/line" } }
      }
    },
    "checkObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "grade", "observed", "evidence_material", "limitations"],
      "properties": {
        "check_id": { "type": "string", "pattern": "^CHECK-[1-9][0-9]*$" },
        "grade": { "enum": ["supported", "partial", "unavailable", "failed"] },
        "observed": { "$ref": "#/$defs/line" },
        "evidence_material": { "type": "array", "maxItems": 2000, "items": { "type": "string", "minLength": 1, "maxLength": 100000 } },
        "limitations": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/line" } }
      },
      "allOf": [
        { "if": { "properties": { "grade": { "enum": ["supported", "partial", "failed"] } }, "required": ["grade"] }, "then": { "properties": { "evidence_material": { "minItems": 1 } } } },
        { "if": { "properties": { "grade": { "enum": ["partial", "unavailable"] } }, "required": ["grade"] }, "then": { "properties": { "limitations": { "minItems": 1 } } } }
      ]
    },
    "authorityCoreInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "schema", "id", "status", "profile", "goal", "acceptance", "risk", "hard_triggers", "authority", "verification"],
      "properties": {
        "artifact": { "const": "work-plan" },
        "schema": { "const": 6 },
        "id": { "type": "string", "pattern": "^wp-[A-Za-z0-9][A-Za-z0-9-]*$" },
        "status": { "const": "ready" },
        "source": { "$ref": "#/$defs/line" },
        "profile": { "enum": ["manual", "supervised", "autonomous"] },
        "predecessor_plan_id": { "type": "string", "pattern": "^wp-[A-Za-z0-9][A-Za-z0-9-]*$" },
        "source_review_id": { "type": "string", "pattern": "^wr-[A-Za-z0-9][A-Za-z0-9-]*$" },
        "goal": { "$ref": "#/$defs/line" },
        "acceptance": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/line" } },
        "non_goals": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/line" } },
        "constraints": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/line" } },
        "risk": { "enum": ["low", "medium", "high"] },
        "hard_triggers": { "type": "array", "uniqueItems": true, "items": { "enum": ["security-secrets", "destructive-data", "regulated-or-monetary", "breaking-external-contract", "irreversible-external-effect", "no-recovery-path", "broad-runtime-impact", "material-uncertainty"] } },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_roots", "protected_paths", "approval_required_paths", "dependencies", "external_effects", "delivery"],
          "properties": {
            "allowed_roots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/targetLine" } },
            "protected_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/targetLine" } },
            "approval_required_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/targetLine" } },
            "dependencies": { "enum": ["deny", "allow-listed"] },
            "allowed_dependencies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/targetLine" } },
            "external_effects": { "const": "none" },
            "delivery": { "const": "repository-only" },
            "max_active_minutes": { "type": "integer", "minimum": 1 },
            "max_total_tokens": { "type": "integer", "minimum": 1 },
            "max_cost_usd": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "objectives", "verification_intent", "expected_evidence", "required", "evidence_class", "cost_class", "prerequisites"],
            "properties": {
              "check_id": { "type": "string", "pattern": "^CHECK-[1-9][0-9]*$" },
              "objectives": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^OBJ-[1-9][0-9]*$" } },
              "verification_intent": { "$ref": "#/$defs/reviewLine" },
              "expected_evidence": { "$ref": "#/$defs/reviewLine" },
              "required": { "type": "boolean" },
              "evidence_class": { "enum": ["harness-verifiable", "reviewer-observable", "human-decision-required"] },
              "cost_class": { "enum": ["cheap", "standard", "expensive"] },
              "prerequisites": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/targetLine" } }
            }
          }
        },
        "certification": { "type": "object" },
        "extensions": { "type": "object" }
      },
      "allOf": [{
        "if": { "anyOf": [{ "required": ["predecessor_plan_id"] }, { "required": ["source_review_id"] }] },
        "then": { "required": ["predecessor_plan_id", "source_review_id"] }
      }]
    },
    "buildPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation", "plan_markdown", "authority_core"],
      "properties": {
        "schema": { "const": 1 },
        "operation": { "const": "build-plan" },
        "plan_markdown": { "$ref": "#/$defs/artifactText" },
        "authority_core": { "$ref": "#/$defs/authorityCoreInput" },
        "presentation_locale": { "$ref": "#/$defs/presentationLocale" }
      }
    },
    "validatePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation", "root_plan"],
      "properties": {
        "schema": { "const": 1 },
        "operation": { "const": "validate-plan" },
        "root_plan": { "$ref": "#/$defs/artifactText" },
        "presentation_locale": { "$ref": "#/$defs/presentationLocale" }
      }
    },
    "buildReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation", "root_plan", "artifacts", "review_input", "repository_observation", "check_observations"],
      "properties": {
        "schema": { "const": 1 },
        "operation": { "const": "build-review" },
        "root_plan": { "$ref": "#/$defs/artifactText" },
        "artifacts": { "$ref": "#/$defs/artifacts" },
        "review_input": { "$ref": "#/$defs/reviewInput" },
        "repository_observation": { "$ref": "#/$defs/repositoryObservation" },
        "check_observations": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/checkObservation" } },
        "presentation_locale": { "$ref": "#/$defs/presentationLocale" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation", "root_plan", "artifacts"],
      "properties": {
        "schema": { "const": 1 },
        "operation": { "const": "status" },
        "root_plan": { "$ref": "#/$defs/artifactText" },
        "artifacts": { "$ref": "#/$defs/artifacts" },
        "presentation_locale": { "$ref": "#/$defs/presentationLocale" }
      }
    }
  }
}
