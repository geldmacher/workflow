{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geldmacher:workflow:harness-capability-receipt:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "harness_id", "harness_version", "deployment_binding_hash", "workspace_binding", "capabilities", "qualification_keys", "policy_hash", "issued_at", "expires_at", "content_hash"],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "harness-capability-receipt" },
    "harness_id": { "type": "string", "minLength": 1 },
    "harness_version": { "type": "string", "minLength": 1 },
    "deployment_binding_hash": { "$ref": "#/$defs/hash" },
    "workspace_binding": { "$ref": "#/$defs/hash" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["phase-execution", "authority-enforcement", "read-only-review", "workspace-snapshot", "evidence-attestation", "budget-reporting", "cancellation"] }
    },
    "qualification_keys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^qk-[A-Za-z0-9][A-Za-z0-9-]*$" } },
    "policy_hash": { "$ref": "#/$defs/hash" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "content_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
