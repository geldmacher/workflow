{
  "name": "@geldmacher/workflow-plugin-development",
  "version": "5.3.0",
  "private": true,
  "description": "Development and controller validation for the adaptive, evidence-calibrated Cursor-native Workflow plugin.",
  "files": [
    ".cursor-plugin",
    "agents",
    "assets",
    "CHANGELOG.md",
    "commands",
    "CONTROLLER_THIRD_PARTY_NOTICES.md",
    "dist/chunks",
    "dist/workflow-capability-spike.mjs",
    "dist/workflow-fanout.mjs",
    "dist/workflow-mcp.mjs",
    "dist/workflow-provision-worker-runtime.mjs",
    "dist/workflow-runner.mjs",
    "dist/workflow-sdk-crash-probe.mjs",
    "dist/workflow-state-maintenance.mjs",
    "dist/workflow-worker.mjs",
    "docs",
    "hooks",
    "LICENSE",
    "mcp.json",
    "npm-shrinkwrap.json",
    "README.md",
    "references",
    "release-surface.json",
    "schemas",
    "scripts/validate-artifact.mjs",
    "skills",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate-plugin.mjs",
    "test": "node --test",
    "context-budget": "node scripts/measure-context.mjs --check",
    "context-baseline": "node scripts/measure-context.mjs --update-baseline",
    "link-check": "node scripts/check-markdown-links.mjs",
    "coverage:critical": "node scripts/check-critical-coverage.mjs",
    "build:runtime-validator": "node scripts/build-runtime-validator.mjs",
    "check:runtime-validator": "node scripts/build-runtime-validator.mjs --check",
    "build:controller": "node scripts/build-controller.mjs",
    "check:controller": "node scripts/build-controller.mjs --check",
    "build:targets": "node scripts/build-plugin-targets.mjs",
    "check:targets": "node scripts/build-plugin-targets.mjs --check",
    "check:agent-plugin": "node scripts/validate-agent-plugin.mjs --build",
    "deploy:prepare": "npm run build:runtime-validator && npm run build:controller && npm run build:targets && npm run check:targets && npm run check:agent-plugin && npm run validate && node --test tests/plugin-targets.test.mjs tests/agent-plugins-target.test.mjs tests/local-plugin-deploy.test.mjs",
    "deploy:status": "node scripts/local-plugin-deploy.mjs status",
    "deploy:local": "node scripts/local-plugin-deploy.mjs deploy",
    "migrate:handoff": "node scripts/migrate-handoff-state.mjs",
    "provision:worker-runtime": "node dist/workflow-provision-worker-runtime.mjs",
    "capability-spike": "node dist/workflow-capability-spike.mjs",
    "capability-spike:crash": "node dist/workflow-sdk-crash-probe.mjs",
    "release:surface": "node scripts/verify-release-surface.mjs",
    "state:maintenance": "node dist/workflow-state-maintenance.mjs",
    "release-check": "npm run check:runtime-validator && npm run check:controller && npm run check:targets && npm run check:agent-plugin && npm test && npm run coverage:critical && npm run context-budget && node scripts/validate-plugin.mjs --release && node scripts/check-markdown-links.mjs && npm run release:surface",
    "validate-artifact": "node scripts/validate-artifact.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.12",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.24",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  }
}
