{
  "description": "Manual Workflow policy gates for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/dist/workflow-hook.mjs\"", "timeout": 10}]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/dist/workflow-hook.mjs\"", "timeout": 10}]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/dist/workflow-hook.mjs\"", "timeout": 10, "statusMessage": "Checking Workflow policy"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/dist/workflow-hook.mjs\"", "timeout": 10}]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/dist/workflow-hook.mjs\"", "timeout": 10}]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/dist/workflow-hook.mjs\"", "timeout": 10}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/dist/workflow-hook.mjs\"", "timeout": 10, "statusMessage": "Checking Workflow closeout"}]
      }
    ]
  }
}
