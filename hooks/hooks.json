{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/closeout-guard.mjs\"",
        "failClosed": false
      },
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/automation-guard.mjs\"",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/closeout-guard.mjs\"",
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/plan-integrity-guard.mjs\"",
        "matcher": "CreatePlan",
        "failClosed": false
      },
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/closeout-guard.mjs\" --enforce",
        "matcher": "MCP:workflow_closeout",
        "failClosed": false
      },
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/automation-guard.mjs\"",
        "matcher": "MCP:workflow_prepare",
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/closeout-guard.mjs\"",
        "matcher": "CreatePlan|MCP:workflow_closeout",
        "failClosed": false
      },
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/automation-guard.mjs\"",
        "matcher": "MCP:workflow_prepare",
        "failClosed": false
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/closeout-guard.mjs\"",
        "matcher": "MCP:workflow_closeout",
        "failClosed": false
      },
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/automation-guard.mjs\"",
        "matcher": "MCP:workflow_prepare",
        "failClosed": false
      }
    ]
  }
}
